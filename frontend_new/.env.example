# Backend API Configuration
# Copy this file to .env and update with your backend server address

# Backend HTTP API URL
VITE_API_URL=http://localhost:8000

# Backend WebSocket URL
VITE_WS_URL=ws://localhost:8000

# For network access from other devices (mobile app, etc.):
# Replace 'localhost' with your computer's IP address
# Example: VITE_API_URL=http://10.138.1.240:8000
# Example: VITE_WS_URL=ws://10.138.1.240:8000
